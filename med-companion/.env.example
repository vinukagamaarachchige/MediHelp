# Optional prescription extraction; without a key only text parsing is available.
ANTHROPIC_API_KEY=

# Remote production URL (HTTPS required for shared deployment).
# Leave empty for localhost-only development. Reverse proxy must preserve Host.
COMPANION_ORIGIN=
# Only if a trusted HTTPS reverse proxy connects from a non-loopback address.
COMPANION_TRUSTED_PROXY_IPS=
# Production server binds to loopback by default. Change only for your deployment.
HOSTNAME_BIND=127.0.0.1
# Optional separate persistent data directory; never put it under public/.
COMPANION_DATA_DIR=

# Use your real HTTPS URL or monitored mailto: contact for production push.
VAPID_SUBJECT=
# Optional existing keys; set both together. Otherwise local keys are generated.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional external scheduler secret, at least 32 characters.
REMINDER_SECRET=

# Optional approved WhatsApp templates and consenting recipients.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TO=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE=
WHATSAPP_LANGUAGE=en_US
CAREGIVER_WHATSAPP_TO=
CAREGIVER_WHATSAPP_TEMPLATE=
